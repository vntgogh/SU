    "def caesar(txt, shift=3):\n",
    "    result = ''\n",
    "    for c in txt:\n",
    "        if 'a' <= c <= 'z':  \n",
    "            # shift letter backwards\n",
    "            result += chr((ord(c) - ord('a') - shift) % 26 + ord('a'))\n",
    "        elif 'A' <= c <= 'Z':  \n",
    "            result += chr((ord(c) - ord('A') - shift) % 26 + ord('A'))\n",
    "        else:\n",
    "            if c != '\\n':  # ignore '\\n'\n",
    "                result += c\n",
    "    return result\n"
   ]
