    "def decypher(txt, dic):\n",
    "    \"\"\"\n",
    "    Déchiffre un texte chiffré par substitution monoalphabétique.\n",
    "    Ne conserve pas les retours à la ligne, les remplace par des espaces.\n",
    "    \"\"\"\n",
