    "def pareto_front(points):\n",
    "    points = sorted(points, key=lambda x: x[0], reverse=True) #reverse pour lordre décroissant\n",
    "    front = []\n",
    "    current_best_y = - float('inf')\n",
    "\n",
    "    for point in points:\n",
    "        if point[1] > current_best_y:\n",
    "            front.append(point)\n",
    "            current_best_y = point[1]\n",
    "\n",
